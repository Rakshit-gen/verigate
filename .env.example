# Copy to .env and fill in. Only a provider key and VERIGATE_API_KEY are
# actually required — everything else has a sane default.

PORT=8080
DATABASE_URL=postgres://localhost:5432/verigate?sslmode=disable
REDIS_ADDR=localhost:6379

# The key YOUR clients send to Verigate itself (Authorization: Bearer <key>).
# Pick anything for local dev.
VERIGATE_API_KEY=dev-local-key

# ── Chat/judge provider ─────────────────────────────────────────────────
# Any OpenAI-compatible provider works via OPENAI_* — Verigate forwards the
# request body and reads back an OpenAI-shaped response. Anthropic is a
# separate, real adapter (different wire protocol, translated both
# directions) selected via PROVIDER_NAME=anthropic. Pick ONE block below.

# --- Option A: OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# PROVIDER_NAME=openai
# JUDGE_MODEL=gpt-4o-mini
# CHAT_MODEL_DEFAULT=gpt-4o-mini

# --- Option B: Groq (recommended for local dev — free tier, very fast, no
# card required: https://console.groq.com/keys) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
PROVIDER_NAME=groq
# Groq's model lineup changes often — if these 404 as "model_not_found",
# check what's actually live for your key: curl -s https://api.groq.com/openai/v1/models
# -H "Authorization: Bearer $OPENAI_API_KEY" | grep '"id"'
JUDGE_MODEL=openai/gpt-oss-120b
CHAT_MODEL_DEFAULT=openai/gpt-oss-20b

# --- Option C: local Ollama (zero cost, zero API key, needs `ollama serve`
# and a pulled model, e.g. `ollama pull llama3.1`) ---
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# PROVIDER_NAME=ollama
# JUDGE_MODEL=llama3.1
# CHAT_MODEL_DEFAULT=llama3.1

# --- Option D: Anthropic (real request/response translation, not just a
# different base URL — see internal/provider/anthropic.go) ---
# PROVIDER_NAME=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Check current model IDs at https://docs.anthropic.com/en/docs/about-claude/models
# before setting these — like Groq, model names get deprecated over time.
# JUDGE_MODEL=claude-...
# CHAT_MODEL_DEFAULT=claude-...

# Note: the cost-tracking table in internal/provider/openai.go only has
# OpenAI's per-model pricing filled in. Groq/Ollama/Anthropic requests will
# show cost_usd = 0 until you add their per-token prices to that map — it
# degrades gracefully rather than guessing at a number.

# If credentials for BOTH an OpenAI-compatible backend (Option A/B/C above)
# AND Anthropic (Option D) are present at once, they're automatically
# chained behind a circuit breaker — PROVIDER_NAME's choice goes first,
# the other becomes the fallback. With only one credential set (the usual
# case), these are unused.
FALLBACK_FAILURE_THRESHOLD=3
FALLBACK_COOLDOWN_SECONDS=30

EVAL_SAMPLE_RATE=0.3

# ── Regression detection ────────────────────────────────────────────────
# Compares the mean of the last REGRESSION_WINDOW eval scores against the
# mean of the REGRESSION_BASELINE_WINDOW scores before that via a z-test —
# catches drift relative to what's normal for THIS deployment, not just an
# absolute number. Falls back to the REGRESSION_MIN_SCORE fixed floor
# automatically until there's enough baseline history (cold start).
REGRESSION_WINDOW=20
REGRESSION_BASELINE_WINDOW=100
REGRESSION_Z_THRESHOLD=2.0
REGRESSION_MIN_SCORE=0.6

# ── Semantic caching (optional) ─────────────────────────────────────────
# Needs a real embeddings-capable key. Groq doesn't serve embeddings, so if
# you're on Option B above, you'd add an OpenAI key here just for this —
# left unset, semantic caching silently stays off and exact-match caching
# (always on) is unaffected either way.
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_ENTRIES=500

# Optional. Unset (default) = spans/metrics pretty-print to stdout, no
# external infra needed. Set to any OTLP/HTTP endpoint (a local OTel
# Collector, Grafana, Honeycomb, Datadog...) to ship the exact same
# instrumentation there instead — zero code changes either way.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
